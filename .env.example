# Copy to .env and fill in. .env is git-ignored; never commit real keys.

# Travelpayouts (https://www.travelpayouts.com) → Profile → API token
TRAVELPAYOUTS_TOKEN=
# Your partner marker (numeric id), appended to Aviasales links for commission
TRAVELPAYOUTS_MARKER=

# Pixabay (https://pixabay.com/api/docs/) → free key, shown on the docs page when logged in
PIXABAY_API_KEY=

# Cloudflare (site deploy): dash.cloudflare.com → My Profile → API Tokens → "Cloudflare Pages: Edit"
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
