# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Secrets and local state (root-level folders only: contract/site/ is tracked)
.env
/data/
/output/
/site/
/logs/
assets/photos/
assets/fonts/*.ttf

# Web package (D28): dependencies, build output, Lighthouse reports, and the site data the
