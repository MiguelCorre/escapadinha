---
// One page per school break, network and origin (D61), at the path school-holidays.json gives
// (/ferias-escolares/<slug>/<origem>/): the break, its network and official source, the travel
// window, and the origin's low prices whose departure and return fall inside it (explorer.ts, the
// same rule as the explorer's filter and the pontes). No matching price: the page says so and
// stays out of search (noindex). A break that has passed keeps its page, noindex, saying so.
// Nothing is built until a human reviewed the calendar: an unreviewed export has no break.
import type { GetStaticPaths } from "astro";
import data from "virtual:site-data";
import Base from "../../../layouts/Base.astro";
import ExplorerResults from "../../../components/ExplorerResults.astro";
import type { SchoolHoliday } from "../../../lib/contract";
import { BRAND } from "../../../lib/brand";
import { breakResults, isPastBreak, placesFor } from "../../../lib/explorer-data";
import { dateRange, dayMonth, schoolHolidayName, schoolHolidayTitle } from "../../../lib/format";

export const getStaticPaths = (() =>
  data.schoolHolidays.breaks.flatMap((b) => b.origins.map((origin) => {
    const match = /^\/ferias-escolares\/([a-z0-9-]+)\/([a-z0-9-]+)\/$/.exec(origin.path);
    if (!match) throw new Error(`school break ${b.slug}: unexpected path ${origin.path}`);
    return { params: { slug: match[1], origem: match[2] }, props: { holiday: b, origin } };
  }))) satisfies GetStaticPaths;

interface Props {
  holiday: SchoolHoliday;
  origin: SchoolHoliday["origins"][number];
}

const { holiday, origin } = Astro.props;
const network = data.schoolHolidays.networks.find((n) => n.key === holiday.network);
const networkName = network?.name ?? holiday.network;
const past = isPastBreak(holiday, data);
const results = breakResults(data, holiday, origin.iata);   // the explorer's links read it too (D66)
const names = Object.fromEntries(data.origins.origins.map((o) => [o.iata, o.name]));
const originInfo = data.origins.origins.find((o) => o.iata === origin.iata) ?? { name: origin.iata };
const title = schoolHolidayTitle(holiday.name, holiday.start, networkName, originInfo);
const label = schoolHolidayName(holiday.name, holiday.start, networkName);
const others = holiday.origins.filter((o) => o.iata !== origin.iata);
const { start, end } = holiday.window;
---
<Base
  title={`${title} · ${BRAND}`}
  description={`${title}: voos de ida e volta com partida a partir de ${dayMonth(start)} e regresso até ${dayMonth(end)}, abaixo do preço habitual de cada rota.`}
  path={origin.path}
  noindex={past || results.length === 0}
>
  <section class="max-w-measure">
    <p class="label text-accent">Férias escolares</p>
    <h1 class="mt-xs font-display text-[clamp(2.25rem,8vw,3.5rem)] leading-none font-medium">{title}</h1>
    {past && (
      <p data-past class="notice notice-warning mt-md">Estas férias já passaram. Vê as próximas no <a href="/explorar/#ferias-escolares">explorador</a>.</p>
    )}
    <p class="mt-md text-lead">{label}: {dateRange(holiday.start, holiday.end)}, sem aulas.</p>
    <p class="mt-xs text-muted">Mostramos voos com partida a partir de {dayMonth(start)} e regresso até {dayMonth(end)}: da véspera ao dia seguinte.</p>
  </section>

  {past ? null : results.length > 0 ? (
    <ExplorerResults heading="Destinos para estas férias" results={results} places={placesFor(data, origin.iata)} disclosure={data.labels.disclosure.site} />
  ) : (
    <p class="notice mt-xl max-w-measure">Ainda não há preços baixos para estas datas. Os preços são verificados várias vezes por dia: volta mais perto das férias ou procura outras datas no <a href="/explorar/">explorador</a>.</p>
  )}

  <section class="mt-2xl max-w-measure text-small text-muted">
    {others.length > 0 && (
      <p data-other-origins>Estas férias com partida de outros aeroportos:
        {others.map((o, i) => <>{i > 0 && " · "}<a href={o.path}>{names[o.iata] ?? o.iata}</a></>)}
      </p>
    )}
    <p class="mt-xs">Mais destinos, datas e filtros no <a href="/explorar/">explorador</a>.</p>
    {network && (
      <p class="mt-xs" data-source>Datas segundo o calendário escolar oficial: <a href={network.source} rel="noopener">{network.source_name}</a>. Cada escola pode ajustar um ou outro dia: confirma com a tua.</p>
    )}
  </section>
</Base>
