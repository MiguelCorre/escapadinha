---
// One page per Portuguese origin (/partidas/<origem>/, D30): every destination watched from there,
// by kind and city name, each linking to its route page with the cheapest price found now
// (routes.json `cheapest`, data-obs) or why there is none. Routes with nothing to show yet (#76,
// src/lib/indexable.ts: their pages are noindex) follow as a compact list of plain links.
import type { GetStaticPaths } from "astro";
import data from "virtual:site-data";
import Base from "../../layouts/Base.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import type { Origin } from "../../lib/contract";
import { BRAND } from "../../lib/brand";
import { upcomingSchoolHolidays } from "../../lib/explorer-data";
import { atPlace, count, eur, fromPlace, schoolHolidayName, shortDate } from "../../lib/format";
import { routeIndexable } from "../../lib/indexable";
import { originGroups } from "../../lib/routes";

export const getStaticPaths = (() => {
  return data.origins.origins.map((origin) => {
    const match = /^\/partidas\/([a-z0-9-]+)\/$/.exec(origin.path);
    if (!match) throw new Error(`origin ${origin.iata}: unexpected path ${origin.path}`);
    return { params: { slug: match[1] }, props: { origin } };
  });
}) satisfies GetStaticPaths;

interface Props {
  origin: Origin;
}

const { origin } = Astro.props;
const groups = originGroups(data, origin.iata).map((g) => ({ ...g,
  shown: g.routes.filter(routeIndexable), unpriced: g.routes.filter((r) => !routeIndexable(r)) }));
const total = groups.reduce((n, g) => n + g.routes.length, 0);
// D61: this origin's pages for the upcoming school breaks (none until the calendar is reviewed).
const networks = Object.fromEntries(data.schoolHolidays.networks.map((n) => [n.key, n.name]));
const ferias = upcomingSchoolHolidays(data).flatMap((b) => {
  const mine = b.origins.find((o) => o.iata === origin.iata);
  return mine ? [{ path: mine.path, label: schoolHolidayName(b.name, b.start, networks[b.network] ?? b.network) }] : [];
});
---
<Base
  title={`Voos baratos ${fromPlace(origin.name, origin.article)}: todos os destinos · ${BRAND}`}
  description={`Os ${total} destinos que acompanhamos ${atPlace("a partir de", origin)}, cada um com o preço de ida e volta mais baixo encontrado agora e a página da rota.`}
  path={origin.path}
>
  <Breadcrumbs crumbs={[{ name: "Partidas", path: "/partidas/" }, { name: origin.name, path: origin.path }]} />

  <header class="mt-lg max-w-measure">
    <h1 class="font-display text-[clamp(2.25rem,8vw,3.5rem)] leading-[1.05] font-medium">Voos {fromPlace(origin.name, origin.article)}</h1>
    <p class="mt-md text-lead text-muted">{count(total, "destino", "destinos")} que acompanhamos {atPlace("a partir de", origin)}, com o preço de ida e volta mais baixo encontrado por viajantes nos últimos {data.meta.detector.max_offer_age_days} dias. Abre uma rota para veres o calendário de preços e o que é habitual em cada mês.</p>
    {ferias.length > 0 && (
      <p data-school-holidays class="mt-sm flex flex-wrap gap-x-md gap-y-xs text-small"><span class="font-semibold">Férias escolares:</span>
        {ferias.map((f) => <a class="inline-flex min-h-6 min-w-6 items-center" href={f.path}>{f.label}</a>)}
      </p>
    )}
  </header>

  {groups.map((g) => (
    <section class="mt-2xl" aria-labelledby={`grupo-${g.kind}`}>
      <h2 id={`grupo-${g.kind}`} class="font-display text-headline">{g.label}</h2>
      {g.shown.length > 0 && (
        <ul class="mt-md grid max-w-measure">
          {g.shown.map((r) => (
            <li data-route={r.key} class="flex flex-wrap items-baseline justify-between gap-x-md gap-y-2xs border-b-2 border-rule py-sm">
              <a href={r.path} class="font-semibold">{r.city}</a>
              {r.status === "dormant" ? (
                <span class="tag tag-expired">rota {data.labels.route_status.dormant}</span>
              ) : r.cheapest ? (
                <span data-obs={r.cheapest.obs} class="text-right">
                  <span class="text-small text-muted">desde </span><span class="num font-display text-title">{eur(r.cheapest.price)}</span>
                  <span class="block num text-small text-muted">{shortDate(r.cheapest.departure)} → {shortDate(r.cheapest.return)}</span>
                </span>
              ) : (
                <span class="text-small text-muted">sem preços recentes</span>
              )}
            </li>
          ))}
        </ul>
      )}
      {g.unpriced.length > 0 && (
        <div data-unpriced class="mt-md max-w-measure">
          <p class="label text-muted">Sem preços para mostrar, por agora</p>
          <ul class="mt-2xs flex flex-wrap gap-x-md gap-y-2xs">
            {g.unpriced.map((r) => (
              <li data-route={r.key}><a href={r.path}>{r.city}</a>{r.status === "dormant" && <span class="text-small text-muted"> (rota {data.labels.route_status.dormant})</span>}</li>
            ))}
          </ul>
        </div>
      )}
    </section>
  ))}
</Base>
