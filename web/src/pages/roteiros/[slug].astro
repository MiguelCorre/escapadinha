---
// One page per itinerary that passed the review gate (D33): /roteiros/<file name>/, with its days,
// best months and a link to the destination hub (when the city is in the data). Route pages and
// the hub link back through ItineraryLink.
import type { GetStaticPaths } from "astro";
import { render } from "astro:content";
import data from "virtual:site-data";
import Base from "../../layouts/Base.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import ContentArticle from "../../components/ContentArticle.astro";
import { MDX_COMPONENTS } from "../../components/mdx-components";
import { itineraries } from "../../collections";
import { BRAND } from "../../lib/brand";
import { contentPath } from "../../lib/content";
import { count, monthList } from "../../lib/format";
import { articleLd } from "../../lib/structured-data";

export const getStaticPaths = (async () => {
  return (await itineraries()).map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}) satisfies GetStaticPaths;

const { entry } = Astro.props;
const it = entry.data;
const { Content } = await render(entry);
// The affiliate blocks in the body find their links by the article (D37).
Astro.locals.article = { key: `itineraries/${entry.id}`, affiliates: it.affiliates };
const hub = data.destinations.destinations.find((d) => d.code === it.destination);
const path = contentPath("itineraries", entry.id);
// Article (D34): by Ponto Nómada, modified when its facts were last checked; none for a draft.
const article = it.reviewed
  ? articleLd(data, { title: it.title, description: it.description, path, lastChecked: it.last_checked })
  : null;
---
<Base
  title={`${it.title} · ${BRAND}`}
  description={it.description}
  path={path}
  noindex={!it.reviewed}
  ogType="article"
  jsonLd={article ? [{ data: article }] : []}
>
  <div class="mb-lg"><Breadcrumbs crumbs={[{ name: "Roteiros", path: "/roteiros/" }, { name: it.title, path }]} /></div>
  <ContentArticle kicker="Roteiro" title={it.title} description={it.description} reviewed={it.reviewed}
    lastChecked={it.last_checked} sources={it.sources}>
    <dl slot="meta" class="mt-lg flex flex-wrap gap-x-xl gap-y-xs text-small">
      <div><dt class="label text-muted">Duração</dt><dd class="num">{count(it.days, "dia", "dias")}</dd></div>
      {it.best_months.length > 0 && (
        <div><dt class="label text-muted">Melhores meses</dt><dd>{monthList(it.best_months)}</dd></div>
      )}
      {hub && (
        <div><dt class="label text-muted">Voos</dt><dd><a href={hub.path}>Como chegar a {hub.city} desde Portugal</a></dd></div>
      )}
    </dl>
    <Content components={MDX_COMPONENTS} />
  </ContentArticle>
  <p class="mt-2xl"><a href="/roteiros/">Todos os roteiros</a></p>
</Base>
