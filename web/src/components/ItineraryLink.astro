---
// Link to the destination's itinerary when one exists (src/lib/itinerary.ts, reviewed entries of
// the itineraries collection, D33); renders nothing otherwise.
import { itineraries } from "../collections";
import { itineraryFor } from "../lib/itinerary";
import { atPlace } from "../lib/format";

interface Props {
  destination: string;
  city: string;
  /** D66: the city's article (destinations.json), for "na Madeira" / "para a Madeira". */
  article?: string | null;
}

const { destination, city, article = null } = Astro.props;
const itinerary = itineraryFor(destination, await itineraries());
---
{itinerary && (
  <p class="notice mt-lg max-w-measure text-ink" data-itinerary>
    O que fazer {atPlace("em", { name: city, article })}: <a href={itinerary.path}>{itinerary.title}</a>
  </p>
)}
