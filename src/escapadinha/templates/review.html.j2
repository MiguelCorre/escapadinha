<!doctype html>
<html lang="pt-PT">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Fila de aprovação · {{ brand.name }}</title>
<style>
:root {
  --bg: #f6f5f2; --surface: #ffffff; --ink: #1d1d1b; --muted: #6b6a66; --line: #e4e2dc;
  --accent: #e2553a; --accent-ink: #ffffff; --ok: #1f7a4d; --ok-bg: #e5f4ec;
  --warn: #9a5b00; --warn-bg: #fdf1dc; --bad: #b3261e; --bad-bg: #fbe7e5;
  --radius: 14px; --shadow: 0 1px 2px rgba(0,0,0,.06), 0 4px 16px rgba(0,0,0,.04);
}
@media (prefers-color-scheme: dark) {
  :root {
    --bg: #141413; --surface: #1e1e1c; --ink: #f2f1ec; --muted: #a3a19a; --line: #33322e;
    --accent: #ff7a5c; --accent-ink: #1a0f0b; --ok: #6fd3a0; --ok-bg: #16301f;
    --warn: #f3c06b; --warn-bg: #33270f; --bad: #ff8f86; --bad-bg: #3a1916;
    --shadow: none;
  }
}
* { box-sizing: border-box; }
body { margin: 0; background: var(--bg); color: var(--ink);
  font: 15px/1.45 "Segoe UI", system-ui, -apple-system, sans-serif; }
header { position: sticky; top: 0; z-index: 2; background: var(--bg); border-bottom: 1px solid var(--line); }
.bar { max-width: 1180px; margin: 0 auto; padding: 14px 16px 0; }
h1 { margin: 0 0 10px; font-size: 20px; letter-spacing: -.2px; }
h1 small { color: var(--muted); font-weight: 400; font-size: 14px; margin-left: 6px; }
nav { display: flex; gap: 4px; overflow-x: auto; }
nav button { border: 0; background: none; color: var(--muted); font: inherit; font-weight: 600;
  padding: 10px 14px; border-bottom: 3px solid transparent; cursor: pointer; white-space: nowrap; }
nav button[aria-selected="true"] { color: var(--ink); border-bottom-color: var(--accent); }
nav .count { display: inline-block; min-width: 22px; padding: 0 6px; margin-left: 6px; border-radius: 999px;
  background: var(--line); color: var(--ink); font-size: 12px; text-align: center; }
main { max-width: 1180px; margin: 0 auto; padding: 18px 16px 60px; display: grid; gap: 16px; }
.empty { text-align: center; color: var(--muted); padding: 60px 16px; }
.card { background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius);
  box-shadow: var(--shadow); display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr); overflow: hidden; }
.slides { display: grid; grid-template-columns: repeat(3, 1fr); gap: 6px; padding: 12px; background: var(--bg); }
.slides a { display: block; aspect-ratio: 4 / 5; border-radius: 8px; overflow: hidden; background: var(--line); }
.slides img { width: 100%; height: 100%; object-fit: cover; display: block; }
.slides .none { grid-column: 1 / -1; aspect-ratio: auto; padding: 30px; text-align: center; color: var(--muted); }
.info { padding: 16px 18px; display: flex; flex-direction: column; gap: 12px; min-width: 0; }
.top { display: flex; justify-content: space-between; gap: 10px; align-items: start; }
.headline { font-size: 18px; font-weight: 700; }
.price { font-size: 26px; font-weight: 800; letter-spacing: -.5px; }
.badge { font-size: 12px; font-weight: 700; padding: 3px 9px; border-radius: 999px; white-space: nowrap;
  background: var(--line); color: var(--ink); }
.badge.approved, .badge.published { background: var(--ok-bg); color: var(--ok); }
.badge.expired, .badge.rejected { background: var(--bad-bg); color: var(--bad); }
.badge.rendered, .badge.new { background: var(--warn-bg); color: var(--warn); }
dl { margin: 0; display: grid; grid-template-columns: max-content 1fr; gap: 4px 14px; font-size: 14px; }
dt { color: var(--muted); }
dd { margin: 0; min-width: 0; overflow-wrap: anywhere; }
.notice { padding: 9px 12px; border-radius: 10px; font-size: 14px; }
#toast { margin: 0; }
.notice.ok { background: var(--ok-bg); color: var(--ok); }
.notice.bad { background: var(--bad-bg); color: var(--bad); }
.notice.warn { background: var(--warn-bg); color: var(--warn); }
details summary { cursor: pointer; color: var(--muted); font-size: 14px; }
pre.caption { white-space: pre-wrap; font: 13px/1.5 "Segoe UI", system-ui, sans-serif; background: var(--bg);
  border-radius: 10px; padding: 10px 12px; margin: 8px 0 0; max-height: 260px; overflow: auto; }
.actions { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; margin-top: auto; }
.actions input { flex: 1 1 180px; min-width: 0; padding: 8px 10px; border-radius: 9px; border: 1px solid var(--line);
  background: var(--surface); color: var(--ink); font: inherit; }
button.btn { border: 1px solid var(--line); background: var(--surface); color: var(--ink); font: inherit; font-weight: 600;
  padding: 8px 13px; border-radius: 9px; cursor: pointer; }
button.btn:hover { border-color: var(--muted); }
button.btn.primary { background: var(--accent); border-color: var(--accent); color: var(--accent-ink); }
button.btn.danger { color: var(--bad); }
button.btn:disabled { opacity: .5; cursor: progress; }
a { color: var(--accent); }
@media (max-width: 820px) { .card { grid-template-columns: 1fr; } }
</style>
</head>
<body>
<header>
  <div class="bar">
    <h1>Fila de aprovação <small>{{ brand.name }} · {{ brand.handle }}</small></h1>
    <nav role="tablist" id="tabs">
      <button role="tab" data-tab="queue">Por rever<span class="count" data-count="queue">0</span></button>
      <button role="tab" data-tab="approved">Aprovados<span class="count" data-count="approved">0</span></button>
      <button role="tab" data-tab="published">Publicados<span class="count" data-count="published">0</span></button>
      <button role="tab" data-tab="closed">Fechados<span class="count" data-count="closed">0</span></button>
    </nav>
  </div>
</header>
<div class="bar" style="padding-top:12px"><p id="toast" role="status" hidden></p></div>
<main id="list" aria-live="polite"></main>

<script>
const EMPTY = {
  queue: "Nenhum deal por rever. Os deals novos aparecem aqui depois de cada recolha (de 2 em 2 horas).",
  approved: "Nenhum deal aprovado à espera de publicação.",
  published: "Ainda nada publicado.",
  closed: "Nenhum deal expirado ou rejeitado.",
};
let tab = new URLSearchParams(location.search).get("tab") || "queue";
const flash = {};   // deal id -> {kind, text} shown after an action

const esc = s => String(s ?? "").replace(/[&<>"']/g, c => ({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));

function row(label, value) { return value ? `<dt>${esc(label)}</dt><dd>${value}</dd>` : ""; }

function card(d) {
  const slides = d.slides.length
    ? d.slides.map((s, i) => `<a href="${s}" target="_blank" rel="noopener" title="Slide ${i + 1}"><img src="${s}" alt="Slide ${i + 1}" loading="lazy"></a>`).join("")
    : `<div class="none">Sem slides (ainda não renderizado)</div>`;
  const deal = d.rule === "median" && d.discount_pct
    ? `−${d.discount_pct}% vs. mínimo habitual ${esc(d.typical_low)} (${d.baseline_days} dias)`
    : d.rule === "price_cap" ? "abaixo do teto de preço da rota" : "";
  const flights = [d.airline, d.direct === true ? "voos diretos" : d.direct === false ? "com escala" : ""].filter(Boolean).join(" · ");
  const link = d.affiliate_url
    ? `<a href="${esc(d.affiliate_url)}" target="_blank" rel="noopener">${esc(d.affiliate_url)}</a>`
    : `<span style="color:var(--bad)">sem link (${esc(d.affiliate_error || "não gerado")})</span>`;
  const notes = [];
  if (flash[d.id]) notes.push(`<div class="notice ${flash[d.id].kind}">${esc(flash[d.id].text)}</div>`);
  if (d.status === "expired") notes.push(`<div class="notice bad">Expirado: ${esc(d.expired_reason)}. Não publicar.</div>`);
  if (d.status === "approved") notes.push(`<div class="notice ok">Aprovado. Publica depressa: o preço é verificado de 2 em 2 horas e o deal expira se mudar.</div>`);
  if (d.review_note) notes.push(`<div class="notice warn">Nota: ${esc(d.review_note)}</div>`);
  for (const p of d.pending) notes.push(`<div class="notice warn">Decisão pendente: ${esc(p.type_pt)} (${esc(p.actor)}, ${esc(p.created_at)}). É aplicada na próxima execução.</div>`);

  const btn = (act, label, cls = "") => `<button class="btn ${cls}" data-act="${act}" data-id="${d.id}">${label}</button>`;
  let actions = "";
  if (d.pending.length) {
    actions = btn("check", "Verificar preço agora");
  } else if (d.status === "rendered" || d.status === "new") {
    actions = `<input data-note="${d.id}" placeholder="Nota (opcional)" aria-label="Nota">`
      + btn("check", "Verificar preço agora") + btn("approve", "Aprovar", "primary") + btn("reject", "Rejeitar", "danger");
  } else if (d.status === "approved") {
    actions = `<input data-note="${d.id}" placeholder="Link do post no Instagram (opcional)" aria-label="Link do post">`
      + btn("check", "Verificar preço agora") + btn("published", "Marcar como publicado", "primary") + btn("reject", "Rejeitar", "danger");
  }
  if (d.whatsapp_text) actions += btn("copy-whatsapp", "Copiar texto do WhatsApp");
  if (d.caption) actions += btn("copy-caption", "Copiar legenda");
  if (d.affiliate_url) actions += btn("copy-link", "Copiar link");

  return `<article class="card" id="deal-${d.id}">
    <div class="slides">${slides}</div>
    <div class="info">
      <div class="top">
        <div><div class="headline">${esc(d.headline)}</div><div class="price">${esc(d.price)} <span style="font-size:14px;font-weight:600;color:var(--muted)">ida e volta</span></div></div>
        <span class="badge ${d.status}">${esc(d.status_pt)}</span>
      </div>
      ${notes.join("")}
      <dl>
        ${row("Datas", esc(`${d.dates} · ${d.nights}`))}
        ${row("Voos", esc(flights))}
        ${row("Chegada", esc(d.arrival_airport))}
        ${row("Deal", esc(deal))}
        ${row("Preço visto", esc([d.found_on && `encontrado a ${d.found_on}`, `verificado a ${d.checked_at}`].filter(Boolean).join(" · ")))}
        ${row("Última verificação", d.last_checked_at ? esc(`${d.last_checked_at}${d.last_seen_price ? ` · ${d.last_seen_price}` : ""}`) : "")}
        ${row("Link", link)}
        ${row("Publicado", d.published_at ? esc(d.published_at) + (d.post_url ? ` · <a href="${esc(d.post_url)}" target="_blank" rel="noopener">ver post</a>` : "") : "")}
        ${row("Pasta", d.output_path ? `<code>${esc(d.output_path)}</code>` : "")}
      </dl>
      ${d.whatsapp_text ? `<details><summary>Texto para o WhatsApp</summary><pre class="caption">${esc(d.whatsapp_text)}</pre></details>` : ""}
      ${d.caption ? `<details><summary>Legenda</summary><pre class="caption">${esc(d.caption)}</pre></details>` : ""}
      <div class="actions">${actions}</div>
    </div>
  </article>`;
}

let current = [];
async function load() {
  document.querySelectorAll("#tabs button").forEach(b => b.setAttribute("aria-selected", b.dataset.tab === tab));
  const res = await fetch(`/api/deals?tab=${tab}`);
  const data = await res.json();
  current = data.deals;
  for (const [t, n] of Object.entries(data.counts)) document.querySelector(`[data-count="${t}"]`).textContent = n;
  document.getElementById("list").innerHTML = current.length
    ? current.map(card).join("") : `<p class="empty">${EMPTY[tab]}</p>`;
}

async function act(action, id, button) {
  const d = current.find(x => x.id === id);
  if (action === "copy-whatsapp") { await navigator.clipboard.writeText(d.whatsapp_text); return say(id, "ok", "Texto do WhatsApp copiado."); }
  if (action === "copy-caption") { await navigator.clipboard.writeText(d.caption); return say(id, "ok", "Legenda copiada."); }
  if (action === "copy-link") { await navigator.clipboard.writeText(d.affiliate_url); return say(id, "ok", "Link copiado."); }
  const input = document.querySelector(`[data-note="${id}"]`);
  const value = input ? input.value.trim() || null : null;
  const body = action === "published" ? {post_url: value} : {note: value};
  document.querySelectorAll(`#deal-${id} button`).forEach(b => b.disabled = true);
  button.textContent = action === "approve" ? "A verificar preço…" : "A processar…";
  try {
    const res = await fetch(`/api/deals/${id}/${action}`, {method: "POST", headers: {"Content-Type": "application/json"}, body: JSON.stringify(body)});
    const data = await res.json();
    if (!res.ok) { flash[id] = {kind: "bad", text: data.detail || "Erro"}; }
    else if (data.decision && data.decision.outcome === "pending") {
      flash[id] = {kind: "warn", text: "Decisão registada: é aplicada na próxima execução."};
    } else if (data.decision && data.decision.outcome !== "applied") {
      flash[id] = {kind: "bad", text: `Decisão recusada: ${data.decision.reason}`};
    } else if (data.check) {
      const c = data.check;
      flash[id] = c.valid
        ? {kind: "ok", text: action === "approve" ? `Preço confirmado (${c.latest_price}) e deal aprovado.` : `Preço confirmado agora: ${c.latest_price}.`}
        : {kind: "bad", text: `O preço mudou: ${c.reason}. ` + (data.deal.status === "expired"
            ? "O deal expirou e não foi aprovado."
            : "Não aprovado: a próxima recolha expira o deal.")};
    } else {
      flash[id] = {kind: "ok", text: action === "reject" ? "Deal rejeitado." : "Marcado como publicado."};
    }
  } catch (e) { flash[id] = {kind: "bad", text: "Sem ligação ao servidor local."}; }
  await load();
  // The deal may have moved to another tab (approved, expired...): say it at the top.
  if (!document.getElementById(`deal-${id}`)) toast(flash[id]);
}

function toast(msg) {
  const t = document.getElementById("toast");
  t.className = `notice ${msg.kind}`; t.textContent = `Deal: ${msg.text}`; t.hidden = false;
}

function say(id, kind, text) {
  flash[id] = {kind, text};
  const d = current.find(x => x.id === id);
  document.getElementById(`deal-${id}`).outerHTML = card(d);
}

document.getElementById("tabs").addEventListener("click", e => {
  const b = e.target.closest("button[data-tab]"); if (!b) return;
  tab = b.dataset.tab; history.replaceState(null, "", `?tab=${tab}`); load();
});
document.getElementById("list").addEventListener("click", e => {
  const b = e.target.closest("button[data-act]"); if (!b) return;
  act(b.dataset.act, Number(b.dataset.id), b);
});
load();
</script>
</body>
</html>
