{% extends "base.html.j2" %}
{% from "macros.html.j2" import deal_card %}
{% block title %}Voos baratos de {{ r.origin_city }} para {{ r.route.city_pt }} · {{ brand.name }}{% endblock %}
{% block description %}Promoções de voos diretos de {{ r.origin_city }} para {{ r.route.city_pt }} e o preço mínimo habitual de ida e volta por mês, com base nos preços que acompanhamos.{% endblock %}
{% block style %}
.lows { list-style: none; padding: 0; margin: 0; display: grid; gap: 10px; max-width: 760px; }
.low { background: var(--surface); border: 1px solid var(--line); border-radius: 12px; padding: 12px 14px;
  display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 10px; }
.low .what { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
.low .price { font: 800 22px var(--display); letter-spacing: -.3px; }
.low .meta { color: var(--muted); font-size: 14px; }
.low .btn { min-height: 44px; padding: 10px 16px; font-size: 15px; }
.small { color: var(--muted); font-size: 14px; }
{% endblock %}
{% block content %}
<p class="lead" style="font-size:14px"><a href="/">Promoções</a> › {{ r.origin_city }} → {{ r.route.city_pt }}</p>
<h1>Voos baratos de {{ r.origin_city }} para {{ r.route.city_pt }}</h1>
<p class="lead">Acompanhamos esta rota várias vezes por dia. Aqui estão as promoções ativas, os preços baixos encontrados nos últimos dias e o preço mínimo habitual de ida e volta, para saberes se um preço é mesmo bom.</p>

<h2>Promoções ativas</h2>
{% if r.live %}
<div class="grid">{% for d in r.live %}{{ deal_card(d) }}{% endfor %}</div>
{% else %}
<p class="empty">Não há promoções ativas nesta rota neste momento.</p>
{% endif %}

<h2>Preços baixos recentes</h2>
{% if r.low_views %}
<p class="small">Preços de ida e volta encontrados por viajantes nos últimos {{ detector_cfg.max_offer_age_days }} dias, pelo menos {{ (detector_cfg.low_threshold * 100) | round | int }}% abaixo do preço mínimo habitual do mês de partida. Aparecem automaticamente, sem revisão: o preço pode já ter mudado, confirma-o antes de pagar.</p>
<ul class="lows" data-route="{{ r.route.key }}">
{% for l in r.low_views %}
  <li class="low" data-obs="{{ l.observation_id }}">
    <div class="what">
      <span><span class="price">{{ l.price }}</span> <span class="tag">−{{ l.discount_pct }}% vs. habitual</span></span>
      <span class="meta">{{ l.dates }} ({{ l.nights }}){% if l.airline %} · {{ l.airline }}{% endif %}{% if l.direct is not none %} · {{ "voos diretos" if l.direct else "com escala" }}{% endif %}</span>
      {% if l.arrival_airport %}<span class="meta">Chegada: aeroporto {{ l.arrival_airport }} · mínimo habitual em {{ l.departure_month }}: {{ l.typical_low }}</span>{% else %}<span class="meta">Mínimo habitual em {{ l.departure_month }}: {{ l.typical_low }}</span>{% endif %}
      <span class="meta">{% if l.found_on %}Encontrado a {{ l.found_on }} · {% endif %}visto por nós a {{ l.fetched_at }}</span>
    </div>
    {% if l.booking_link %}<a class="btn" href="{{ l.booking_link }}" rel="sponsored nofollow noopener" target="_blank">Ver voo →</a>{% else %}<span class="meta">Link de reserva indisponível de momento</span>{% endif %}
  </li>
{% endfor %}
</ul>
<p class="small" style="margin-top:10px">{{ site_disclosure }} Os links abrem o site parceiro (Aviasales) em euros.</p>
{% else %}
<p class="empty">Não há preços baixos recentes nesta rota neste momento.</p>
{% endif %}

<h2>Preço mínimo habitual por mês de partida</h2>
{% if r.months %}
<table data-route="{{ r.route.key }}">
  <thead><tr><th>Partida em</th><th>Mínimo habitual</th><th>Dias de dados</th></tr></thead>
  <tbody>
  {% for label, price, days in r.months %}<tr><td>{{ label }}</td><td class="num">{{ price }}</td><td>{{ days }}</td></tr>{% endfor %}
  </tbody>
</table>
<p class="lead" style="font-size:14px; margin-top:10px">Mediana dos preços mais baixos encontrados em cada dia, por pessoa, ida e volta, voos diretos. Não é uma garantia de preço.</p>
{% else %}
<p class="empty">Ainda estamos a recolher dados suficientes para esta rota.</p>
{% endif %}

{% if r.recent %}
<h2>Promoções recentes (já expiradas)</h2>
<div class="grid">{% for d in r.recent %}{{ deal_card(d) }}{% endfor %}</div>
{% endif %}
{% endblock %}
