{% extends "a-caderno/_layout.html.j2" %}
{% set title = brand.name ~ " · Direção A · Início" %}
{% block style %}
.lead { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: 36px; padding-block: 36px 40px; align-items: start; }
.lead img { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; }
.lead h2 { font-size: clamp(34px, 5vw, 58px); font-weight: 500; }
.lead h2 em { color: var(--accent); font-style: italic; }
.standfirst { font-size: 20px; line-height: 1.55; margin: 18px 0 14px; }
.standfirst::first-letter { font: 600 3.1em/0.82 var(--display); float: left; padding: 5px 8px 0 0; }
.section-head { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; flex-wrap: wrap; padding: 22px 0 6px; }
.section-head h2 { font-size: clamp(26px, 3.6vw, 34px); font-style: italic; font-weight: 500; }
.columns { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); padding: 18px 0 36px; }
.columns article { padding: 0 22px; border-left: 1px solid var(--rule); }
.columns article:nth-child(3n + 1) { border-left: 0; padding-left: 0; }
.columns article:nth-child(n + 4) { margin-top: 28px; padding-top: 22px; border-top: 1px solid var(--rule); }
.columns .no { font: italic 400 44px/1 var(--display); color: var(--accent); }
.columns img { width: 100%; aspect-ratio: 3 / 2; object-fit: cover; margin: 12px 0; filter: saturate(.85) contrast(1.02); }
.columns h3 { font-size: 24px; font-weight: 600; }
.columns .price { font: 500 40px/1.1 var(--display); margin: 6px 0 4px; }
.columns .price small { font: italic 400 16px var(--text); color: var(--muted); }
.columns p { margin: 0; }
.archive { padding-block: 10px 30px; }
.archive ol { list-style: none; padding: 0; margin: 0; }
.archive li { display: grid; grid-template-columns: 1fr auto; gap: 4px 20px; padding: 16px 0; border-bottom: 1px solid var(--rule); }
.archive .t { font: 500 22px/1.3 var(--display); }
.archive s { font: 500 26px/1.2 var(--display); color: var(--muted); }
.archive .why { grid-column: 1 / -1; color: var(--muted); font-size: 15px; }
.stamp { display: inline-block; font: 600 12px/1 var(--text); text-transform: uppercase; letter-spacing: .14em;
  border: 1px solid var(--accent); color: var(--accent); padding: 5px 8px; margin-right: 8px; vertical-align: 3px; }
.empty { font-style: italic; color: var(--muted); padding: 20px 0 30px; }
@media (max-width: 860px) {
  .lead { grid-template-columns: 1fr; gap: 20px; }
  .columns { grid-template-columns: 1fr; }
  .columns article, .columns article:nth-child(3n + 1) { border-left: 0; padding: 0; }
  .columns article + article { margin-top: 26px; padding-top: 22px; border-top: 1px solid var(--rule); }
}
{% endblock %}
{% block body %}
<header class="wrap masthead">
  <div class="top"><span>Viagens · Inspiração · Experiências</span><span>{% if d.latest_run_at %}Edição de {{ d.latest_run_at }}{% endif %}</span></div>
  <hr class="double">
  <div style="padding-top: 22px">
    <a class="brand" href="index.html">{{ ui.mark("line", 46) }}<span class="name">{{ brand.name }}</span></a>
    <p class="tagline">{{ brand.tagline }}</p>
  </div>
</header>
<div class="wrap"><hr class="double"></div>

<main>
{% set lead = d.hero %}
{% if lead %}
<section class="wrap lead" aria-labelledby="lead-title">
  <figure>
    {{ ui.img(lead.trip, root, has_photo, eager=true) }}
    <figcaption>{{ lead.trip.destination_city }}. {{ ui.credit(lead.trip.photo) }}</figcaption>
  </figure>
  <div>
    <p class="kicker">Preço baixo · {{ lead.discount_pct }}% abaixo do habitual</p>
    <h2 id="lead-title">{{ lead.trip.origin_city }} → {{ lead.trip.destination_headline }}, <em>{{ lead.trip.price }}</em> ida e volta</h2>
    <p class="standfirst">Um viajante encontrou este preço a {{ lead.trip.found_on or "data desconhecida" }} para {{ lead.trip.dates }} ({{ lead.trip.nights }}){% if lead.trip.airline %}, com a {{ lead.trip.airline }}{% endif %}. Em {{ lead.trip.month }}, o preço habitual nesta rota anda pelos {{ lead.typical_low }}.{% if lead.trip.arrival_airport %} A chegada é ao aeroporto {{ lead.trip.arrival_airport }}.{% endif %}</p>
    <p class="meta">Verificado por nós a {{ lead.trip.fetched_at }}. {% if lead.trip.direct %}Voos diretos nos dois sentidos. {% endif %}Preço encontrado, não ao vivo: pode já ter mudado.</p>
  </div>
</section>
<div class="wrap"><hr class="rule"></div>
{% endif %}

<section class="wrap" aria-labelledby="lows-title">
  <div class="section-head">
    <h2 id="lows-title">Também esta semana</h2>
    <span class="meta">Preços baixos: abaixo do habitual de cada rota no mês da partida</span>
  </div>
  {% if d.lows|length > 1 %}
  <div class="columns">
    {% for low in d.lows[1:7] %}
    <article>
      <div class="no">{{ loop.index + 1 }}.</div>
      {{ ui.img(low.trip, root, has_photo) }}
      <h3>{{ low.trip.origin_city }} → {{ low.trip.destination_headline }}</h3>
      <p class="price">{{ low.trip.price }} <small>ida e volta</small></p>
      <p>{{ low.trip.departure_short }} – {{ low.trip.return_short }} · {{ low.trip.nights }}{% if low.trip.airline %} · {{ low.trip.airline }}{% endif %}</p>
      <p class="meta">Habitual em {{ low.trip.month }}: {{ low.typical_low }} ({{ low.discount_pct }}% abaixo). Encontrado a {{ low.trip.found_on }}. Chegada: {{ low.trip.arrival_airport }}.</p>
    </article>
    {% endfor %}
  </div>
  {% else %}
  <p class="empty">Hoje não há outros preços abaixo do habitual. O caderno volta a abrir na próxima recolha.</p>
  {% endif %}
</section>

<div class="wrap"><hr class="rule"></div>
<section class="wrap archive" aria-labelledby="archive-title">
  <div class="section-head">
    <h2 id="archive-title">Arquivo de promoções</h2>
    <span class="meta">Promoções que já passaram, guardadas como registo</span>
  </div>
  {% if d.promos %}
  <ol>
    {% for p in d.promos %}
    <li>
      <span class="t">{% if not p.live %}<span class="stamp">Expirada</span>{% endif %}{% if d.featured and p.deal_id == d.featured.deal_id %}<a href="promocao.html">{{ p.trip.origin_city }} → {{ p.trip.destination_headline }}</a>{% else %}{{ p.trip.origin_city }} → {{ p.trip.destination_headline }}{% endif %}, {{ p.trip.dates }}</span>
      {% if p.live %}<span class="num" style="font-size: 26px">{{ p.trip.price }}</span>{% else %}<s>{{ p.trip.price }}</s>{% endif %}
      <span class="why">{% if p.live %}Ativa. {% else %}{{ p.expired_reason|capitalize if p.expired_reason else "Expirada" }}. {% endif %}{% if p.trip.found_on %}Encontrado a {{ p.trip.found_on }}, {% endif %}verificado a {{ p.checked_at }}.</span>
    </li>
    {% endfor %}
  </ol>
  {% else %}
  <p class="empty">Ainda não há promoções revistas.</p>
  {% endif %}
</section>
</main>
{% endblock %}
