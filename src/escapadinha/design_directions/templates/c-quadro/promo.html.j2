{% extends "c-quadro/_layout.html.j2" %}
{% set p = d.featured %}
{% set title = brand.name ~ " · Direção C · Promoção" %}
{% block style %}
.head { padding: 24px 0 10px; display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 16px 30px; align-items: end; }
.head .codes { font: 800 clamp(40px, 9vw, 104px)/0.95 var(--mono); letter-spacing: -0.04em; }
.head h1 { font-size: clamp(22px, 3vw, 32px); margin-top: 10px; }
.head .price { font: 800 clamp(48px, 9vw, 104px)/0.95 var(--mono); text-align: right; }
.head s.price { color: var(--muted); }
.alert { border: 2px solid var(--bad); color: var(--ink); padding: 12px 14px; margin: 14px 0 0; display: flex; flex-wrap: wrap; gap: 8px 14px; align-items: center; }
.alert.info { border-color: var(--line); }
.facts { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); border-top: 2px solid var(--line); border-left: 2px solid var(--line); margin: 22px 0 0; }
.facts div { border-right: 2px solid var(--line); border-bottom: 2px solid var(--line); padding: 12px 14px; background: var(--surface); }
.facts dd { margin: 4px 0 0; font: 600 18px/1.3 var(--mono); overflow-wrap: anywhere; }
.strip { display: grid; grid-template-columns: 260px minmax(0, 1fr); gap: 24px; margin-top: 26px; align-items: start; }
.strip img { width: 100%; aspect-ratio: 1; object-fit: cover; filter: grayscale(1) contrast(1.15); }
.strip .credit { font-size: 12px; color: var(--muted); margin-top: 6px; }
.strip .credit a { color: inherit; }
.bars { list-style: none; padding: 0; margin: 0; display: grid; gap: 8px; }
.bars li { display: grid; grid-template-columns: 150px minmax(0, 1fr) 90px; gap: 12px; align-items: center; font-family: var(--mono); font-size: 14px; }
.bars .bar { height: 22px; background: var(--line); position: relative; }
.bars .bar span { position: absolute; inset: 0 auto 0 0; background: var(--signal); }
.bars .v { text-align: right; font-weight: 700; }
.cta { display: inline-block; background: var(--signal); color: var(--on-signal); font: 800 16px var(--mono); text-transform: uppercase; padding: 14px 20px; text-decoration: none; border: 2px solid var(--on-signal); }
@media (max-width: 820px) {
  .head { grid-template-columns: 1fr; }
  .head .price { text-align: left; }
  .facts { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .strip { grid-template-columns: 1fr; }
  .strip img { aspect-ratio: 16 / 9; }
  .bars li { grid-template-columns: 1fr 80px; }
  .bars .bar { grid-column: 1 / -1; grid-row: 2; }
}
{% endblock %}
{% block body %}
<main>
{% if p %}
<section>
  <div class="wrap">
    <p class="label" style="margin-top: 18px"><a href="index.html">Início</a> / Promoções / #{{ p.deal_id }}</p>
    <div class="head">
      <div>
        <div class="codes">{{ p.trip.origin_iata }}→{{ p.trip.arrival_code or p.trip.destination_iata }}</div>
        <h1>{{ p.trip.origin_city }} → {{ p.trip.destination_headline }}</h1>
      </div>
      <div>
        {% if p.live %}<span class="tag good">Ativa</span>{% else %}<span class="tag bad">Expirada</span>{% endif %}
        {% if p.live %}<div class="price">{{ p.trip.price_compact }}</div>{% else %}<div><s class="price">{{ p.trip.price_compact }}</s></div>{% endif %}
        <div class="label" style="text-align: inherit">Ida e volta · por pessoa</div>
      </div>
    </div>
    {% if not p.live %}
    <div class="alert"><span class="tag bad">Expirada</span><span>{{ ui.expired_note(p) }}</span></div>
    {% elif p.booking_url %}
    <p style="margin-top: 16px"><a class="cta" href="{{ p.booking_url }}" rel="sponsored nofollow noopener" target="_blank">Ver voo e reservar →</a></p>
    {% endif %}
    {% if p.trip.remote_airport %}
    <div class="alert info"><span class="tag signal">Aeroporto</span><span>Chega a {{ p.trip.arrival_airport }}, longe do centro de {{ p.trip.destination_city }}.</span></div>
    {% endif %}
    <dl class="facts">
      <div><dt class="label">Partida</dt><dd>{{ p.trip.departure_short }}</dd></div>
      <div><dt class="label">Regresso</dt><dd>{{ p.trip.return_short }}</dd></div>
      <div><dt class="label">Noites</dt><dd>{{ p.trip.nights }}</dd></div>
      <div><dt class="label">Companhia</dt><dd>{{ p.trip.airline or "—" }}</dd></div>
      <div><dt class="label">Voos</dt><dd>{% if p.trip.direct is none %}—{% elif p.trip.direct %}Diretos{% else %}Com escala{% endif %}</dd></div>
      <div><dt class="label">Chegada</dt><dd>{{ p.trip.arrival_airport or p.trip.destination_iata }}</dd></div>
      <div><dt class="label">Encontrado (viajante)</dt><dd>{{ p.trip.found_on or "—" }}</dd></div>
      <div><dt class="label">Verificado (nós)</dt><dd>{{ p.checked_at }}</dd></div>
      {% if p.typical_low %}<div><dt class="label">Habitual na deteção</dt><dd>{{ p.typical_low }}</dd></div>{% endif %}
      {% if p.discount_pct %}<div><dt class="label">Abaixo do habitual</dt><dd class="good">−{{ p.discount_pct }}%</dd></div>{% endif %}
    </dl>

    <div class="strip">
      <div>
        {{ ui.img(p.trip, root, has_photo, eager=true) }}
        <p class="credit">{{ ui.credit(p.trip.photo) }}</p>
      </div>
      <div>
        <h2 class="label" style="font-size: 13px; margin-bottom: 10px">Habitual por mês de partida · {{ p.trip.origin_iata }}–{{ p.trip.destination_iata }}</h2>
        {% if d.route_months %}
        {% set top = d.route_months|map(attribute="value")|max %}
        <ul class="bars">
          {% for m in d.route_months %}
          <li><span>{{ m.label }}</span><span class="bar" aria-hidden="true"><span style="width: {{ (m.value / top * 100)|round(1) }}%"></span></span><span class="v">{{ m.typical_low }}</span></li>
          {% endfor %}
        </ul>
        <p class="label" style="margin-top: 8px">{% for m in d.route_months %}{{ m.days }} dias de dados ({{ m.label }}){{ " · " if not loop.last }}{% endfor %}</p>
        {% else %}
        <p>Ainda sem dias suficientes para um preço habitual.</p>
        {% endif %}
      </div>
    </div>
  </div>
</section>

<section class="block" aria-labelledby="now-title">
  <div class="wrap">
    <h2 id="now-title">Agora nesta rota</h2>
    {% if d.route_lows %}
    <table class="board">
      <thead><tr><th>Datas</th><th>Cia</th><th>Chegada</th><th class="r">Habitual</th><th>Encontrado</th><th class="r">Preço</th></tr></thead>
      <tbody>
      {% for low in d.route_lows %}
      <tr>
        <td class="mono dest-cell">{{ low.trip.departure_short }} – {{ low.trip.return_short }} · {{ low.trip.nights }}</td>
        <td class="wide" data-l="Cia">{{ low.trip.airline or "—" }}</td>
        <td class="mono wide" data-l="Chegada">{{ low.trip.arrival_airport }}</td>
        <td class="mono r wide" data-l="Habitual">{{ low.typical_low }}</td>
        <td class="mono wide" data-l="Encontrado">{{ low.trip.found_on }}</td>
        <td class="price-cell r"><span class="price">{{ low.trip.price_compact }}</span></td>
      </tr>
      {% endfor %}
      </tbody>
    </table>
    {% else %}
    <p>Nenhum preço abaixo do habitual nesta rota agora.</p>
    {% endif %}
    <p class="disclosure" style="margin-top: 18px; font-size: 14px">{{ p.disclosure }}</p>
  </div>
</section>
{% else %}
<div class="wrap block"><h1>Sem promoções revistas.</h1></div>
{% endif %}
</main>
{% endblock %}
