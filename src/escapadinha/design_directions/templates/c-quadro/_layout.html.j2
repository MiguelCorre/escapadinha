{% import "_shared.html.j2" as ui %}
<!doctype html>
<html lang="pt-PT">
<head>
{{ ui.head(direction, title, root) }}
<style>
:root { --display: "Space Grotesk", "Segoe UI", system-ui, sans-serif; --mono: "JetBrains Mono", Consolas, "SFMono-Regular", monospace; }
body { font: 400 16px/1.55 var(--display); }
a { color: var(--ink); text-underline-offset: 3px; text-decoration-thickness: 2px; }
h1, h2, h3 { font-family: var(--display); font-weight: 700; line-height: 1.05; margin: 0; letter-spacing: -0.02em; }
.wrap { max-width: 1240px; margin: 0 auto; padding: 0 16px; }
.mono { font-family: var(--mono); font-variant-numeric: tabular-nums; }
.dir-bar { background: var(--bg); color: var(--muted); font-family: var(--mono); font-size: 12px; text-transform: uppercase; }
.dir-bar .here { color: var(--ink); text-decoration: underline; }
.dir-bar button { border-radius: 0; font-family: var(--mono); text-transform: uppercase; }
.label { font: 600 12px/1.2 var(--mono); text-transform: uppercase; letter-spacing: .08em; color: var(--muted); }
.tag { display: inline-block; font: 700 12px/1 var(--mono); text-transform: uppercase; letter-spacing: .06em; padding: 5px 7px; }
.tag.signal { background: var(--signal); color: var(--on-signal); }
.tag.bad { color: var(--bad); border: 2px solid var(--bad); padding: 3px 5px; }
.tag.good { color: var(--good); border: 2px solid var(--good); padding: 3px 5px; }
.good { color: var(--good); }
.bad { color: var(--bad); }

.masthead { background: var(--board); color: var(--board-ink); }
.masthead .wrap { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 10px 24px; padding-top: 14px; padding-bottom: 14px; }
.masthead a.brand { display: inline-flex; align-items: center; gap: 12px; color: var(--board-ink); text-decoration: none; }
.masthead .name { font: 700 clamp(22px, 3.4vw, 30px)/1 var(--display); text-transform: uppercase; letter-spacing: .02em; }
.masthead .clock { font: 500 13px/1.4 var(--mono); text-transform: uppercase; }
.sub { border-bottom: 2px solid var(--line); }
.sub .wrap { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 6px 20px; padding-top: 10px; padding-bottom: 10px; }
.sub span { font: 500 13px var(--mono); color: var(--muted); }

/* Photo treatment: small, square, black and white; colour is reserved for data. */
.thumb { width: 56px; height: 56px; object-fit: cover; filter: grayscale(1) contrast(1.15); flex: none; }

/* The board: a table on wide screens, stacked rows on phones. */
.board { width: 100%; border-collapse: collapse; background: var(--surface); }
.board th { background: var(--board); color: var(--board-ink); font: 600 12px/1.2 var(--mono); text-transform: uppercase; letter-spacing: .08em; text-align: left; padding: 10px 12px; white-space: nowrap; }
.board td { padding: 12px; border-bottom: 1px solid var(--line); vertical-align: middle; }
.board td.r, .board th.r { text-align: right; }
.board .dest { display: flex; align-items: center; gap: 12px; }
.board td.dest-cell { min-width: 230px; }
.board .city { font-weight: 700; font-size: 18px; }
.board .code { font: 500 13px var(--mono); color: var(--muted); }
.board .price { font: 800 26px/1 var(--mono); white-space: nowrap; }
.board s.price { color: var(--muted); font-weight: 600; }
.board tr:hover td { background: color-mix(in srgb, var(--signal) 12%, var(--surface)); }
@media (max-width: 820px) {
  .board thead { display: none; }
  .board, .board tbody, .board tr, .board td { display: block; }
  .board tr { display: grid; grid-template-columns: 1fr auto; gap: 4px 12px; padding: 14px 12px; border-bottom: 2px solid var(--line); }
  .board td { border: 0; padding: 0; }
  .board td.dest-cell { grid-column: 1 / 2; }
  .board td.price-cell { grid-column: 2; grid-row: 1; text-align: right; }
  .board td.wide { grid-column: 1 / -1; }
  .board td[data-l]::before { content: attr(data-l) " "; font: 600 11px var(--mono); text-transform: uppercase; color: var(--muted); letter-spacing: .06em; }
  .board td.r { text-align: left; }
  .board td.price-cell.r { text-align: right; }
}
section.block { padding-block: 28px; }
section.block > .wrap > h2 { font-size: clamp(24px, 3.4vw, 34px); text-transform: uppercase; display: flex; flex-wrap: wrap; align-items: baseline; gap: 10px 16px; margin-bottom: 14px; }
footer.foot { border-top: 2px solid var(--line); padding: 22px 0 30px; font-size: 14px; }
footer.foot p { max-width: 90ch; margin: 0 0 8px; color: var(--muted); }
footer.foot .disclosure { color: var(--ink); }

.spec { background: var(--surface); border-top: 6px solid var(--signal); }
.spec h2 { font-size: clamp(24px, 3.4vw, 34px); text-transform: uppercase; margin-bottom: 12px; }
.spec h3 { font: 600 13px var(--mono); text-transform: uppercase; letter-spacing: .08em; margin: 22px 0 8px; }
.spec-kicker { font: 600 12px var(--mono); text-transform: uppercase; color: var(--muted); margin: 0 0 8px; }
.spec-rationale { max-width: 72ch; font-size: 17px; }
.spec-note, .spec li { font-size: 14px; }
.spec table { font-family: var(--mono); font-size: 12px; }
.spec .chip { border-radius: 0; }
{% block style %}{% endblock %}
</style>
</head>
<body>
{{ ui.dir_bar(direction, page, root) }}
<header class="masthead">
  <div class="wrap">
    <a class="brand" href="index.html">{{ ui.mark("board", 38) }}<span class="name">{{ brand.name }}</span></a>
    <span class="clock">{% if d.latest_run_at %}Atualizado {{ d.latest_run_at }}{% endif %}</span>
  </div>
</header>
<div class="sub"><div class="wrap"><span>{{ brand.tagline }}</span><span>Viagens · Inspiração · Experiências</span></div></div>
{% block body %}{% endblock %}
<footer class="foot">
  <div class="wrap">
    <p class="mono">{{ d.n_observations }} preços observados · {{ d.n_routes }} rotas{% if d.first_seen %} · desde {{ d.first_seen }}{% endif %} · fonte: Aviasales (cache de pesquisas de viajantes, não ao vivo) · horas de Lisboa · gerado {{ d.built_at }}</p>
    <p class="disclosure">{{ disclosure }}</p>
  </div>
</footer>
{{ ui.spec(direction) }}
</body>
</html>
