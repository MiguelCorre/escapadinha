{% extends "base.html.j2" %}
{% block photo_class %}dim{% endblock %}
{% block style %}
.cta { font-size: 150px; margin-top: 40px; }
.cta .hl { color: var(--sun); }
.sub { font-size: 44px; line-height: 1.3; margin-top: 36px; max-width: 840px; }
.handle { font-family: var(--display); font-weight: 700; font-size: 48px; margin-top: 46px; }
.disclosure { font-size: 27px; line-height: 1.4; color: var(--ink-soft); padding: 24px 28px;
  border-radius: 18px; background: rgba(0,0,0,.35); border: 1px solid rgba(255,255,255,.25); }
{% endblock %}
{% block kicker %}<div class="kicker">Reserva já</div>{% endblock %}
{% block body %}
<div class="spacer"></div>
<div class="display cta">Link<br>na <span class="hl">bio</span></div>
<div class="sub">{{ v.origin_city }} → {{ v.destination_headline }} desde {{ v.price }}. Estes preços desaparecem depressa.</div>
<div class="handle">{{ brand.handle }}</div>
<div class="spacer"></div>
<div class="disclosure">{{ v.disclosure }}</div>
{% endblock %}
{% block footnote %}{% if v.photo.photographer %}Foto: {{ v.photo.photographer }} / {{ v.photo.source }}{% endif %}{% endblock %}
