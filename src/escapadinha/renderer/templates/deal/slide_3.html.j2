{% extends "base.html.j2" %}
{% import "_ui.html.j2" as ui with context %}
{# Call to action (dark): photo fades into ink, text only on the solid part. Carries DISCLOSURE. #}
{% block slide_class %}dark{% endblock %}
{% block style %}
.cta { font-size: var(--fs-display-xl); font-style: italic; line-height: .98; }
.cta .hl { color: var(--pn-accent); }
.sub { font-size: var(--fs-lead); line-height: 1.3; margin-top: 30px; }
.sub .num { font-family: var(--display); font-weight: 600; }
.handle { font: italic 500 var(--fs-title)/1.2 var(--display); color: var(--pn-accent); margin-top: 26px; }
.notice { margin-top: 40px; color: var(--pn-ink); }
.foot .caption { color: var(--pn-muted); }
{% endblock %}
{% block canvas %}
{{ ui.photo_layer(photo_uri, "top") }}
<div class="fade-top"></div>
{% endblock %}
{% block content %}
{{ ui.masthead("dark", "Reserva já", "stamp") }}
<div class="spacer"></div>
<div class="display cta">Link na <span class="hl">bio</span></div>
<p class="sub">{{ v.origin_city }} → {{ v.destination_headline }} desde <span class="num">{{ v.price }}</span>. Estes preços desaparecem depressa.</p>
<div class="handle">{{ brand.handle }}</div>
<p class="notice">{{ v.disclosure }}</p>
<div class="foot">
  <span class="caption">{{ ui.credit(v.photo, v.destination_city) }}</span>
  {{ ui.dots(slide_no, total_slides) }}
</div>
{% endblock %}
