{% extends "base.html.j2" %}
{% import "_ui.html.j2" as ui with context %}
{# Cover: full-bleed photo, masthead on a top scrim, everything to read on a paper card. #}
{% block style %}
.route { font-size: var(--fs-headline); font-weight: 600; line-height: 1.08; }
.route .to { color: var(--pn-accent); }
.card .pb { margin-top: 28px; }
{% endblock %}
{% block canvas %}
{{ ui.photo_layer(photo_uri) }}
<div class="scrim-top"></div>
{% endblock %}
{% block content %}
{{ ui.masthead("dark", "Promoção", "stamp") }}
<div class="spacer"></div>
<div class="scrim-bottom">
  <div class="over on-photo">{{ ui.dots(slide_no, total_slides) }}<span class="caption">{{ ui.credit(v.photo, v.destination_city) }}</span></div>
  <div class="card">
    <div><div class="display route fit">{{ v.origin_city }} <span class="to">→</span> {{ v.destination_headline }}</div></div>
    {{ ui.price_block(v, "xl") }}
  </div>
</div>
{% endblock %}
