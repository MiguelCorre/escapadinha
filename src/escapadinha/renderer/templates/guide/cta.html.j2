{% extends "base.html.j2" %}
{% block photo_class %}dim{% endblock %}
{% block style %}
.cta { font-size: 120px; line-height: 1.04; }
.handle { font-family: var(--display); font-weight: 700; font-size: 52px; margin-top: 44px; color: var(--sun); }
.disclosure { margin-top: 40px; font-size: 27px; line-height: 1.4; color: var(--ink-soft); padding: 24px 28px;
  border-radius: 18px; background: rgba(0,0,0,.35); border: 1px solid rgba(255,255,255,.25); }
{% endblock %}
{% block kicker %}<div class="kicker">{{ g.kicker }}</div>{% endblock %}
{% block body %}
<div class="spacer"></div>
<div class="display cta">{{ g.cta }}</div>
<div class="handle">Segue {{ brand.handle }} para mais promoções</div>
{% if g.affiliate %}<div class="disclosure">{{ disclosure }}</div>{% endif %}
<div class="spacer"></div>
{% endblock %}
{% block footnote %}{% if photo.photographer %}Foto: {{ photo.photographer }} / {{ photo.source }}{% endif %}{% endblock %}
