  "failures": {
    "description": "When the provider can't price the deal, the reviewer reads a pt-PT reason without English or response text (pipeline.check_failure, live-check.ts liveCheck). Each case is one provider answer: an HTTP status (with a body), a payload, no answer at all, or no API token.",
    "cases": [
      {
        "name": "rate limited",
        "http_status": 429,
        "body": "Too Many Requests",
        "expected": "Não foi possível verificar o preço agora: o Travelpayouts está a limitar os pedidos. Tenta daqui a um minuto."
      },
      {
        "name": "server error",
        "http_status": 502,
        "body": "Bad gateway",
        "expected": "Não foi possível verificar o preço agora: o Travelpayouts respondeu com o erro HTTP 502."
      },
      {
        "name": "refused token",
        "http_status": 401,
        "body": "Unauthorized",
        "expected": "Não foi possível verificar o preço agora: o Travelpayouts respondeu com o erro HTTP 401."
      },
      {
        "name": "error in the payload",
        "payload": {
          "success": false,
          "error": "rate limit",
          "data": null
        },
        "expected": "Não foi possível verificar o preço agora: o Travelpayouts devolveu um erro."
      },
      {
        "name": "no answer",
        "network_error": true,
        "expected": "Não foi possível verificar o preço agora: o Travelpayouts não respondeu."
      },
      {
        "name": "no API token",
        "token": "",
        "expected": "Não foi possível verificar o preço agora: falta o token do Travelpayouts (TRAVELPAYOUTS_TOKEN)."
      }
    ]
  },
  "queries": {
    "description": "The provider request that prices a deal's route-month (D39). The pipeline builds it from the route's rules and the collector config (collector.travelpayouts.request_params: the collection, so the recheck, and pipeline.price_now ask with it) and the review snapshot carries it as live_check.query; the review Function sends it as is (string values on the wire). A route that takes only nonstop flights both ways (direct_only, or max_transfers 0) asks with direct=true, because the cache keeps one offer per date pair, the cheapest, and a cheaper offer with a stop would hide the nonstop fare; any other route keeps the plain call.",
    "collector": {
      "currency": "eur",
      "limit": 1000,
      "market": "pt"
    },
    "cases": [
      {
        "name": "direct-only route (europe, domestic): nonstop fares only",
        "origin": "LIS",
        "destination": "LON",
        "month": "2026-11",
        "rules": {
          "direct_only": true,
          "max_transfers": 0,
          "min_nights": 2,
          "max_nights": 10,
          "max_offer_age_days": 3
        },
        "expected": {
          "origin": "LIS",
          "destination": "LON",
          "departure_at": "2026-11",
          "one_way": "false",
          "currency": "eur",
          "sorting": "price",
          "unique": "false",
          "limit": 1000,
          "direct": "true",
          "market": "pt"
        }
      },
      {
        "name": "a stop limit of 0 takes nothing else either",
        "origin": "LIS",
        "destination": "NYC",
        "month": "2026-12",
        "rules": {
          "direct_only": false,
          "max_transfers": 0,
          "min_nights": 5,
          "max_nights": 21,
          "max_offer_age_days": 3
        },
        "expected": {
          "origin": "LIS",
          "destination": "NYC",
          "departure_at": "2026-12",
          "one_way": "false",
          "currency": "eur",
          "sorting": "price",
          "unique": "false",
          "limit": 1000,
          "direct": "true",
          "market": "pt"
        }
      },
      {
        "name": "long-haul: one stop allowed, the plain call",
        "origin": "LIS",
        "destination": "NYC",
        "month": "2026-12",
        "rules": {
          "direct_only": false,
          "max_transfers": 1,
          "min_nights": 7,
          "max_nights": 21,
          "max_offer_age_days": 3
        },
        "expected": {
          "origin": "LIS",
          "destination": "NYC",
          "departure_at": "2026-12",
          "one_way": "false",
          "currency": "eur",
          "sorting": "price",
          "unique": "false",
          "limit": 1000,
          "market": "pt"
        }
      },
      {
        "name": "no stop limit: the plain call",
        "origin": "OPO",
        "destination": "TYO",
        "month": "2027-01",
        "rules": {
          "direct_only": false,
