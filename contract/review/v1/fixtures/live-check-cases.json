    "now": "2026-10-14T09:30:00Z",
    "deal": {
      "origin": "LIS",
      "destination": "LON",
      "price_eur": 58,
      "departure_date": "2026-11-20",
      "return_date": "2026-11-23",
      "direct": true,
      "rules": {
        "direct_only": true,
        "max_transfers": 0,
        "min_nights": 2,
        "max_nights": 10,
        "max_offer_age_days": 3
      }
    },
    "item": {
      "origin": "LIS",
      "destination": "LON",
      "origin_airport": "LIS",
      "destination_airport": "LGW",
      "airline": "TP",
      "flight_number": "1336",
      "transfers": 0,
      "return_transfers": 0,
      "departure_at": "2026-11-20T07:05:00+00:00",
      "return_at": "2026-11-23T19:40:00+00:00",
      "link": "/search/LIS2011LON23111?t=TP&search_date=14102026"
    }
  },
